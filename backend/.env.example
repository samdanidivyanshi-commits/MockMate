# ─── Server ───────────────────────────────────────────
PORT=5000

# ─── MongoDB ──────────────────────────────────────────
# Local:  mongodb://localhost:27017/mockmate
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/mockmate
MONGO_URI=mongodb://localhost:27017/mockmate

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# ─── AI Feedback ──────────────────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
# If left blank, feedback falls back to a simple length-based heuristic
# instead of failing the request.
ANTHROPIC_API_KEY=
